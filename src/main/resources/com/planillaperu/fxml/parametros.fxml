<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.planillaperu.ui.RonaldmichaParametrosController" styleClass="view">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Historial de versiones" styleClass="title-md"/>
            <Label text="Cada periodo usa la versión vigente más reciente que empezó en ese mes o antes."
                   styleClass="text-muted" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonAnular" text="Anular versión" styleClass="btn" onAction="#anular" minWidth="-Infinity"/>
        <Button fx:id="botonNueva" text="Nueva versión" styleClass="btn, btn-primary" onAction="#nuevaVersion"
                minWidth="-Infinity"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No hay versiones registradas" styleClass="text-muted"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colDesde" text="Vigente desde" prefWidth="110"/>
            <TableColumn fx:id="colNorma" text="Norma" prefWidth="160"/>
            <TableColumn fx:id="colRmv" text="RMV" prefWidth="110"/>
            <TableColumn fx:id="colUit" text="UIT" prefWidth="110"/>
            <TableColumn fx:id="colTasas" text="Tasas" prefWidth="300"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="colRegistro" text="Registrado por" prefWidth="170"/>
        </columns>
    </TableView>

    <VBox fx:id="detalle" styleClass="card" spacing="10">
        <Label fx:id="tituloDetalle" styleClass="title-md"/>
        <Label fx:id="textoDetalle" styleClass="text-muted" wrapText="true"/>
        <Label fx:id="textoAnulacion" styleClass="alert, warning" wrapText="true" maxWidth="Infinity"/>
        <TableView fx:id="tablaComisiones" maxWidth="520">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colAfp" text="AFP" prefWidth="160"/>
                <TableColumn fx:id="colFlujo" text="Comisión flujo" prefWidth="140"/>
                <TableColumn fx:id="colMixta" text="Comisión mixta" prefWidth="140"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
