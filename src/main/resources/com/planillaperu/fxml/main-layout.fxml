<?xml version="1.0" encoding="UTF-8"?>

<?import com.planillaperu.ui.components.RonaldmichaWorkerComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.planillaperu.ui.RonaldmichaMainLayout">
    <BorderPane>
        <left>
            <VBox fx:id="sidebar" styleClass="sidebar">
                <VBox fx:id="marca" styleClass="sidebar-brand">
                    <Label text="Planilla Perú" styleClass="sidebar-brand-title"/>
                    <Label fx:id="subtituloMarca" text="Gestión de planillas" styleClass="sidebar-brand-subtitle"/>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox fx:id="menu" spacing="2"/>
                </ScrollPane>
            </VBox>
        </left>
        <center>
            <BorderPane>
                <top>
                    <HBox styleClass="app-header">
                        <VBox styleClass="titulo-encabezado" alignment="CENTER_LEFT">
                            <Label fx:id="tituloVista" styleClass="view-title" minWidth="-Infinity"/>
                            <Label fx:id="subtituloVista" styleClass="subtitulo-vista" minWidth="0"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <RonaldmichaWorkerComboBox fx:id="buscador" promptText="Buscar trabajador…" prefWidth="280" minWidth="0"
                                        styleClass="buscador-global"/>
                        <Button fx:id="campana" styleClass="btn-ghost, btn-icon" onAction="#mostrarAprobaciones"/>
                        <ComboBox fx:id="selectorMes" styleClass="combo-mes" minWidth="132" prefWidth="132"/>
                        <ComboBox fx:id="selectorAnio" styleClass="combo-anio" minWidth="96" prefWidth="96"/>
                        <Label fx:id="chipPeriodo" styleClass="chip" minWidth="-Infinity"/>
                        <MenuButton fx:id="menuUsuario" styleClass="user-menu" minWidth="-Infinity"/>
                    </HBox>
                </top>
                <center>
                    <StackPane fx:id="contenido" styleClass="content"/>
                </center>
            </BorderPane>
        </center>
    </BorderPane>
</StackPane>
