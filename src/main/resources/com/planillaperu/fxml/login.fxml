<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.planillaperu.ui.RonaldmichaLoginController" styleClass="login-bg">
    <VBox styleClass="card, login-card" maxWidth="380" maxHeight="-Infinity">
        <VBox spacing="4">
            <Label text="Planilla Perú" styleClass="login-title"/>
            <Label text="Inicia sesión para continuar" styleClass="text-muted"/>
        </VBox>

        <HBox styleClass="segmented">
            <ToggleButton fx:id="opcionAdmin" text="Administrador" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="opcionTrabajador" text="Trabajador" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="6">
            <Label fx:id="etiquetaUsuario" text="Usuario" styleClass="field-label"/>
            <TextField fx:id="campoUsuario"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="campoClave" onAction="#ingresar"/>
        </VBox>

        <Button fx:id="botonIngresar" text="Ingresar" styleClass="btn, btn-primary" maxWidth="Infinity"
                onAction="#ingresar"/>
        <Label fx:id="mensajeError" styleClass="alert, error" wrapText="true" maxWidth="Infinity"/>

        <HBox alignment="CENTER">
            <Hyperlink text="Restablecer datos de demostración" onAction="#restablecerDemo"/>
        </HBox>
    </VBox>
</StackPane>
