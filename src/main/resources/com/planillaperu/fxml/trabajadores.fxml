<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.planillaperu.ui.RonaldmichaTrabajadoresController" styleClass="view">

    <VBox styleClass="card" spacing="10">
        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
            <TextField fx:id="buscar" promptText="Buscar por nombre o documento" prefWidth="290"/>
            <ComboBox fx:id="filtroArea" prefWidth="190"/>
            <ComboBox fx:id="filtroEstado" prefWidth="130"/>
            <Button fx:id="botonImportar" text="Importar" styleClass="btn, btn-excel" onAction="#importar"/>
            <Button fx:id="botonPlantilla" text="Plantilla CSV" styleClass="btn, btn-excel" onAction="#descargarPlantilla"/>
            <Button text="Exportar (Excel)" styleClass="btn, btn-excel" onAction="#exportar"/>
            <Button fx:id="botonNuevo" text="+ Nuevo trabajador" styleClass="btn, btn-primary" onAction="#nuevo"/>
        </FlowPane>
        <Label fx:id="resumen" styleClass="text-muted"/>
    </VBox>

    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="74"/>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="118"/>
                <TableColumn fx:id="colNombre" text="Apellidos y nombres" prefWidth="250"/>
                <TableColumn fx:id="colArea" text="Área" prefWidth="120"/>
                <TableColumn fx:id="colRegimen" text="Régimen" prefWidth="100"/>
                <TableColumn fx:id="colIngreso" text="Ingreso" prefWidth="96"/>
                <TableColumn fx:id="colBasico" text="Básico" prefWidth="110"/>
                <TableColumn fx:id="colPension" text="Pensión" prefWidth="130"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="96" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
